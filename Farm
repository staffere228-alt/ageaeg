    lastTarget = nil
    disableNoClip()
    -- Died подключаем СРАЗУ (раньше — через wait(1), смерть терялась)
    local hum = char:WaitForChild("Humanoid", 10)
    if hum then
        hum.Died:Connect(function()
            isRoundActive = false
            disableNoClip()
        end)
