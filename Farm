local function isCollected(coin)
    local now = tick()
    for _, d in ipairs(collectedCoins) do
        if d.coin == coin and now < d.time + IGNORE_DUR then return true end
    end
    return false
end

local function markCollected(coin)
    table.insert(collectedCoins, {coin = coin, time = tick()})
    if #collectedCoins > MAX_IGNORED then table.remove(collectedCoins, 1) end
end

-- 🎲 СЛУЧАЙНЫЙ выбор монеты (замена старого getNearestCoin):
-- собираем все валидные монеты, сортируем по дистанции и берём СЛУЧАЙНУЮ
-- из нескольких ближайших (взвешенно: ближние чаще). Боты разлетаются по
-- разным монетам вместо того, чтобы лететь цепочкой за первой.
--   RandomPickTop = 1 → старое поведение (строго ближайшая)
--   RandomPickTop = 0 → полностью случайная любая монета на карте
local function getRandomCoin(container, hrp)
    if not container or not hrp then return nil, math.huge end
    local candidates = {}
    for _, part in ipairs(container:GetChildren()) do
        if not part:IsA("BasePart") then continue end
        if not part.Name:lower():find("coin") then continue end
        if isCollected(part) then continue end
        local d = (part.Position - hrp.Position).Magnitude
        table.insert(candidates, { part = part, dist = d })
    end
    if #candidates == 0 then return nil, math.huge end
    table.sort(candidates, function(a, b) return a.dist < b.dist end)

    -- мягкий лимит дальности: если есть монеты ближе RandomPickMinDist,
    -- дальние не рассматриваем (не летим через полкарты)
    if SETTINGS.RandomPickMinDist and SETTINGS.RandomPickMinDist > 0 then
        local near = {}
        for _, c in ipairs(candidates) do
            if c.dist <= SETTINGS.RandomPickMinDist then table.insert(near, c) end
        end
        if #near > 0 then candidates = near end
    end

    local n = #candidates
    local top = SETTINGS.RandomPickTop
    if top == 1 then return candidates[1].part, candidates[1].dist end
    if top <= 0 then
        local c = candidates[math.random(1, n)]
        return c.part, c.dist
    end

    -- взвешенный выбор из top ближайших: вес ближней максимальный
    local k = math.min(top, n)
    local total = k * (k + 1) / 2
    local roll = math.random() * total
    local acc = 0
    local chosen = candidates[1]
    for i = 1, k do
        acc = acc + (k - i + 1)
        if roll <= acc then chosen = candidates[i]; break end
    end
    return chosen.part, chosen.dist
end

-- 🎲 Случайный сдвиг точки прилёта вокруг монеты (равномерно по кругу):
-- боты съезжаются к одной монете с разных сторон, а не по одной траектории
local function randomArrivalOffset()
    local spread = SETTINGS.ArrivalSpread or 0
    if spread <= 0 then return Vector3.zero end
    local a = math.random() * 2 * math.pi
    local r = math.sqrt(math.random()) * spread
    return Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
end

-- ================= TWEEN =================
local function tweenToTarget(hrp, targetPos)
    if currentTween then pcall(function() currentTween:Cancel() end) end
    local dist = (targetPos - hrp.Position).Magnitude
    -- 🎲 персональная скорость аккаунта: боты обгоняют друг друга, а не летят строем
    local speed = math.max(5, SETTINGS.MoveSpeed + speedOffset)
    local moveTime = math.max(dist / speed, 0.1)
    local tweenInfo = TweenInfo.new(moveTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
    currentTween = tween
    isMoving = true
    -- фикс гонки: старый твин не обнулит ссылку на новый
    tween.Completed:Connect(function()
        if currentTween == tween then
            isMoving = false
            currentTween = nil
        end
    end)
    tween:Play()
end

