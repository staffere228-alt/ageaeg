-- 🎲 ФИКС: парсинг чисел с сокращениями и разделителями:
-- "1,234" → 1234 | "1.2K" → 1200 | "2.5M" → 2500000 | "12" → 12
local function parseCount(text)
    text = tostring(text or ""):gsub("[,%s]", "")
    local numPart, suffix = text:match("^(%d+%.?%d*)%s*([KkMmBb]?)$")
    if not numPart then
        return tonumber(text:match("%d+")) or 0
    end
    local mult = { k = 1e3, m = 1e6, b = 1e9 }
    local value = tonumber(numPart) or 0
    if suffix ~= "" then value = value * (mult[suffix:lower()] or 1) end
    return math.floor(value + 0.5)
end

